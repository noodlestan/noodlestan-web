{
  "name": "apps-noodlestan-web",
  "version": "0.0.1",
  "description": "Static website application built with Astro, hosted on AWS S3 with CloudFront CDN.",
  "keywords": [
    "web-app",
    "astro",
    "website",
    "static-site",
    "documentation"
  ],
  "author": "Noodlestan",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/noodlestan/noodlestan-web.git",
    "directory": "apps/noodlestan-web"
  },
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "type": "module",
  "prettier": "@noodlestan/prettier-config-astro",
  "scripts": {
    "dev": "astro dev",
    "lint": "prettier . -c && eslint . && tsc --noEmit",
    "lint:fix": "prettier . -c --write && eslint . --fix",
    "build:clean": "rm -rf dist",
    "build": "astro build",
    "test": "echo none yet",
    "preview": "astro preview",
    "start": "astro",
    "ci": "npm run build && npm run lint && npm run test"
  },
  "dependencies": {
    "@noodlestan/astro-components": "*",
    "astro": "7.4.2"
  },
  "devDependencies": {
    "@noodlestan/prettier-config-astro": "0.1.1",
    "prettier-plugin-astro": "1.1.0"
  }
}
