---
import { ENDPOINTS } from "../../../consts";

const contactUrl = `mailto:${ENDPOINTS.noodlestan.email}`;
---

<section id="contributing">
	<h2>Contributing</h2>
	<p>
		Did you find a bug? Do you have an idea? Want to contribute, discuss
		something, or just say hello?
	</p>
	<p>You are welcome.</p>
	<nav>
		<ul>
			<li>
				<a href={ENDPOINTS.noodlestan.discord}>Discord</a>
			</li>
			<li>
				<a href={ENDPOINTS.noodlestan.github}>GitHub</a>
			</li>
			<li>
				<a href={contactUrl}>Contact</a>
			</li>
		</ul>
		<p>Contributions, questions, bug reports, and ideas are welcome.</p>
	</nav>
</section>
