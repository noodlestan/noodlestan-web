---
import { ENDPOINTS } from '../../../constants';
import { HowToContribute } from '@noodlestan/astro-components';

const contactUrl = `mailto:${ENDPOINTS.noodlestan.email}`;
---

<section class="main-section">
	<a id="contributing" class="main-anchor" />
	<h2>Contributing</h2>
	<HowToContribute
		githubURL={ENDPOINTS.noodlestan.github}
		discordURL={ENDPOINTS.noodlestan.discord}
		contactURL={contactUrl}
	/>
</section>
