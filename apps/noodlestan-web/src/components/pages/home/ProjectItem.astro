---
interface Props {
	project: {
		data: {
			project: {
				name: string;
				description: string;
				code: string | null;
				website: string | null;
			};
		};
	};
}

const { project } = Astro.props;
const hasLinks = project.data.project.code || project.data.project.website;
---

<article>
	<h3>{project.data.project.name}</h3>
	<p>{project.data.project.description}</p>
	{hasLinks && (
		<nav>
			<ul>
				{project.data.project.code && (
					<li>
						<a href={project.data.project.code}>GitHub</a>
					</li>
				)}
				{project.data.project.website && (
					<li>
						<a href={project.data.project.website}>Website</a>
					</li>
				)}
			</ul>
		</nav>
	)}
</article>

<style>
	article {
		display: flex;
		flex-direction: column;
		gap: 0.25rem;
		height: 100%;
		padding: 1.5rem 2rem;
		background-color: var(--color-surface-bg);
	}

	h3 {
		margin-block: 0;
		line-height: 1.2;
	}

	p {
		flex: 1;
		min-height: 10rem;
	}

	nav {
		padding-block-start: 1rem;
	}

	ul {
		display: flex;
		flex-wrap: wrap;
		row-gap: 0.5rem;
		column-gap: 1rem;
		margin: 0;
		padding: 0;
	}

	li {
		margin: 0;
		list-style: none;
	}
</style>
