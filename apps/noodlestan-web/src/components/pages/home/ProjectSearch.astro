---
---

<div class="project-search">
	<label for="project-search-input">Search projects</label>
	<input
		id="project-search-input"
		type="search"
		placeholder="Search by name, purpose, or description"
	/>
	<p class="project-search-status" role="status">
		<span data-project-search-count></span>
		<span data-project-search-empty hidden>
			No projects match
		</span>
	</p>
</div>

<script>
	function filterProjects(): void {
		const searchInput = document.querySelector<HTMLInputElement>('#project-search-input');
		if (!(searchInput instanceof HTMLInputElement)) {
			return;
		}

		const listSection = searchInput.closest('section');
		if (!(listSection instanceof HTMLElement)) {
			return;
		}

		const countElement = listSection.querySelector<HTMLElement>('[data-project-search-count]');
		const emptyElement = listSection.querySelector<HTMLElement>('[data-project-search-empty]');
		if (!countElement || !emptyElement) {
			return;
		}

		const query = searchInput.value.trim().toLowerCase();
		const projectItems = listSection.querySelectorAll<HTMLElement>('li[data-search]');
		let visibleCount = 0;

		for (const projectItem of projectItems) {
			const searchText = projectItem.dataset.search ?? '';
			const matchesQuery = query === '' || searchText.includes(query);
			projectItem.hidden = !matchesQuery;
			if (matchesQuery) {
				visibleCount += 1;
			}
		}

		const hasVisibleProjects = visibleCount > 0;
		emptyElement.hidden = hasVisibleProjects;
		countElement.textContent = hasVisibleProjects ? `${visibleCount} projects found` : '';
	}

	function initializeProjectSearch(): void {
		const searchInput = document.querySelector<HTMLInputElement>('#project-search-input');
		if (!(searchInput instanceof HTMLInputElement)) {
			return;
		}

		searchInput.addEventListener('input', filterProjects);
		filterProjects();
	}

	initializeProjectSearch();
</script>

<style>
	.project-search {
		display: flex;
		flex-direction: column;
		gap: 0.5rem;
		margin-block: 1rem;
		max-width: var(--text-max-width);
	}

	label {
		font-family: var(--type-input-family);
		font-weight: 600;
		letter-spacing: var(--type-spacing-compact);
		color: var(--color-interactive);
		font-size: var(--text-size-large);
	}

	input[type='search'] {
		width: 100%;
		padding: 0.75rem 1rem;
		font-family: var(--type-input-family);
		font-size: var(--text-size-body);
		line-height: var(--text-line-height);
		color: var(--color-content);
		background-color: var(--color-surface-bg);
		border: 1px solid var(--color-interactive);
		border-radius: 0.25rem;
	}

	input[type='search']::placeholder {
		color: var(--color-content);
		opacity: 0.6;
	}

	input[type='search']:focus-visible {
		outline: 2px solid var(--color-interactive);
		outline-offset: 2px;
	}

	.project-search-status {
		min-height: 1.75rem;
		color: var(--color-content);
	}
</style>
