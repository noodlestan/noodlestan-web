---
import SiteLogo from '../../site/SiteLogo.astro';
---

<section id="hero">
	<h1>
		<span>Welcome to</span>
		<span>Noodlestan</span>
	</h1>
	<figure>
		<SiteLogo />
	</figure>
	<p class="text-large">
		A home for software projects, experiments, crazy ideas, and things worth building.
	</p>
</section>

<style>
	:root {
		/* 1.2rem @ 100px → 4.5rem @ 640px */
		--__font-size-welcome: clamp(1.2rem, calc(1.2rem + (100vw - 5rem) * 0.06111), 4.5rem);
		/* 1.6rem @ 100px → 6rem @ 640px */
		--__font-size-noodlestan: clamp(1.6rem, calc(1.6rem + (100vw - 5rem) * 0.08148), 6rem);
	}

	section {
		padding-block-start: 4rem;
		display: flex;
		flex-direction: column;
		gap: 1rem;
		align-items: center;
	}

	h1 {
		margin: 0;
		text-align: center;
	}

	span {
		display: block;
	}

	span:first-child {
		font-size: var(--__font-size-welcome);
		font-weight: 300;
		letter-spacing: var(--type-spacing-compact);
	}

	span:last-child {
		font-family: var(--type-brand-family);
		font-size: var(--__font-size-noodlestan);
		font-weight: 700;
		color: var(--color-brand);
	}

	figure {
		width: min(80vw, 300px);
	}

	p {
		text-align: center;
		max-width: 33rem;
		margin-inline: var(--page-margin-h);
	}
</style>
