---
import { NoodlestanLogoMark } from '@noodlestan/astro-components';
import SiteLogo from '../../site/SiteLogo.astro';
---

<section id="hero">
	<h1>
		<span>Welcome to</span>
		<span>Noodlestan</span>
	</h1>
	<figure>
		<NoodlestanLogoMark />
	</figure>
	<p class="text-large">
		A home for software projects, experiments, crazy ideas, and things worth building.
	</p>
</section>

<style>
	:root {
		/* 1.2rem @ 100px → 4.5rem @ 640px */
		/* 1.6rem @ 100px → 6rem @ 640px */
	}

	#hero {
		padding-block-start: 4rem;
		display: flex;
		flex-direction: column;
		gap: 1rem;
		align-items: center;
	}

	h1 {
		margin: 0;
		text-align: center;
	}

	span {
		display: block;
	}

	span:first-child {
		font-size: var(--text-size-hero-welcome);
		font-weight: 300;
		letter-spacing: var(--type-spacing-compact);
	}

	span:last-child {
		font-family: var(--type-brand-family);
		font-size: var(--text-size-hero-brand);
		font-weight: 700;
		color: var(--color-brand);
	}

	figure,
	#hero :global(svg) {
		width: min(80vw, 300px);
	}

	#hero :global(svg) {
		height: auto;
	}

	p {
		text-align: center;
		max-width: 33rem;
		margin-inline: var(--page-margin-h);
	}
</style>
