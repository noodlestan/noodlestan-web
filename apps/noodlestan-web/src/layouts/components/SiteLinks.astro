---
import { GithubIconLink, DiscordIconLink } from '@noodlestan/astro-components';
import { ENDPOINTS } from '../../constants';
---

<div class="site-links">
	<GithubIconLink
		href={ENDPOINTS.noodlestan.github}
		iconLabel="Noodlestan organization on GitHub"
	/>
	<DiscordIconLink href={ENDPOINTS.noodlestan.discord} />
</div>

<style>
	.site-links {
		display: inline-flex;
		justify-content: end;
		gap: 1rem;
		margin-bottom: -0.25rem;
		font-size: calc(var(--text-size-nav) * 0.85);
		line-height: 1;
	}

	@media screen and (min-width: 1022px) {
		.site-links {
			width: 13rem;
		}
		.site-nav {
			display: flex;
		}
	}
</style>
