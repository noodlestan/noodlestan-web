---
import SiteHeaderContainer from './SiteHeaderContainer.astro';
import SiteHeaderDivider from './SiteHeaderDivider.astro';
import SiteLinks from './SiteLinks.astro';
import SiteNav from './SiteNav.astro';
import SiteTitle from './SiteTitle.astro';
---

<SiteHeaderContainer>
	<div class="container">
		<a class="site-title" href="/">
			<SiteTitle />
		</a>
		<div class="site-nav">
			<SiteNav />
		</div>
		<SiteLinks />
	</div>
	<SiteHeaderDivider />
</SiteHeaderContainer>

<style>
	.container {
		position: relative;
		z-index: 1;
		display: flex;
		flex-wrap: wrap;
		align-items: flex-end;
		justify-content: space-between;
		row-gap: 1rem;
		column-gap: 2rem;
		padding-block: 1.5rem;
	}

	.site-title {
		text-decoration: none;
	}

	.site-nav {
		display: none;
	}

	@media screen and (min-width: 1022px) {
		.site-nav {
			display: flex;
		}
	}
</style>
