---
import { ENDPOINTS } from '../../consts';
---

<footer>
	<div class="container copyright">
		<p class="small">
			<span class="year">Copyright © 2026</span> <a href={ENDPOINTS.noodlestan.site}>Noodlestan</a>
		</p>
	</div>
	<div class="container legal text-small">
		<p class="license">
			Code and content available on{' '}
			<a class="external-link" href={ENDPOINTS.noodlestan.github}>
				<span>GitHub</span>
			</a>{' '}
			under an{' '}
			<a class="external-link" href={ENDPOINTS.noodlestan.license}>
				<span>MIT LICENSE</span>
			</a>
			.
		</p>
		<div class="notices">
			<p class="notice">
				This site respects your privacy: no cookies, analytics, or tracking tools are used.
			</p>
			<p class="notice">This site is built with open source knowledge and tools.</p>
		</div>
	</div>
</footer>

<style>
	footer {
		--text-max-width: 33rem;
		padding-block: 7rem 5rem;
		background: linear-gradient(
			180deg,
			var(--color-gradient-3) 90%,
			var(--color-gradient-2) 90%,
			var(--color-gradient-2) 95%,
			var(--color-gradient-1) 95%
		);
	}

	.copyright {
		font-family: var(--type-headings-family);
		font-size: 1.2rem;
		font-weight: 400;
	}

	footer,
	.legal,
	.notices {
		display: flex;
		flex-direction: column;
		gap: 1rem;
	}

	.legal,
	.notices {
		gap: 0.25rem;
	}

	.legal {
		font-family: var(--type-headings-family);
		font-size: 0.8rem;
		font-weight: 100;
	}
</style>
