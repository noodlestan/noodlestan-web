---
import { ENDPOINTS } from '../../constants';
import { NoodlestanFooter } from '@noodlestan/astro-components';
---

<footer>
	<div class="container">
		<NoodlestanFooter year={2026} githubURL={ENDPOINTS.noodlestan.github} />
	</div>
</footer>

<style>
	footer {
		--text-max-width: 33rem;
		display: flex;
		padding-block: 7rem 5rem;
		font-family: var(--type-headings-family, var(--type-noodlestan-family, sans-serif));
		background: linear-gradient(
			180deg,
			var(--color-gradient-3) 90%,
			var(--color-gradient-2) 90%,
			var(--color-gradient-2) 95%,
			var(--color-gradient-1) 95%
		);
	}
</style>
