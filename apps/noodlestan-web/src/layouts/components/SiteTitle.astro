---
import { NoodlestanLogo } from '@noodlestan/astro-components';

import SiteLogo from '../../components/site/SiteLogo.astro';
---

<span class="logo">
	<!-- <SiteLogo /> -->
	<NoodlestanLogo />
</span>

<style>
	.logo {
		display: flex;
		align-items: flex-start;
		height: 2rem;
		gap: 0.25rem;
		color: var(--color-brand);
		font-family: var(--type-brand-family);
		font-size: var(--text-size-nav);
		font-weight: 700;
		text-decoration: none;
	}

	.logo :global(.wordmark) {
		display: none;
	}

	@media screen and (min-width: 375px) {
		.logo :global(.wordmark) {
			display: inline-block;
		}
	}
</style>
