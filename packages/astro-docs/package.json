{
  "name": "@noodlestan/astro-docs",
  "version": "0.0.1",
  "description": "Shared Astro docs components for all Noodlestan Astro sites.",
  "keywords": [
    "astro",
    "components",
    "documentation"
  ],
  "author": "Noodlestan Collective",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/noodlestan/noodlestan-web.git",
    "directory": "packages/astro-docs/"
  },
  "private": false,
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "src",
    "LICENSE-MIT",
    "README.md",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./global.css": "./src/styles/global.css"
  },
  "prettier": "@noodlestan/prettier-config-astro",
  "scripts": {
    "preview": "astro preview --root test/astro --watch",
    "lint": "prettier . -c && eslint . && tsc --noEmit",
    "lint:fix": "prettier . --write && eslint . --fix",
    "build": "astro build --root test/astro",
    "build:clean": "rm -rf dist",
    "test": "echo none yet",
    "ci": "npm run lint && npm run build && npm run test"
  },
  "dependencies": {
    "@purrtrait/astro-components": "0.0.1"
  },
  "peerDependencies": {
    "astro": "^7.4.2"
  },
  "devDependencies": {
    "@noodlestan/prettier-config-astro": "0.1.1",
    "@purrception/lang-ts": "0.1.1",
    "prettier-plugin-astro": "1.1.0"
  }
}
