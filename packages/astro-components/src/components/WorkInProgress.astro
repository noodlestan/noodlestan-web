---
type Props = {
	label?: string;
	linkHref?: string;
	linkLabel?: string;
};

const { label, linkHref, linkLabel } = Astro.props;

const hasLink = Boolean(linkHref) && Boolean(linkLabel);
---

<span class="work-in-progress">
	{label ?? 'Work in progress'}
	{hasLink && <a href={linkHref}>{linkLabel}</a>}
</span>

<style>
	.work-in-progress {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		padding: 0.1rem 0.6rem;
		border: 1px solid var(--color-interactive, currentColor);
		border-radius: 999px;
		font-family: var(--type-noodlestan-family);
		font-size: var(--text-size-small, 0.85rem);
		line-height: 1.5;
	}
</style>
