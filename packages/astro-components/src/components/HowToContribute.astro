---
type Props = {
	githubURL: string;
	discordURL: string;
	contactURL: string;
};

const { githubURL, discordURL, contactURL } = Astro.props;
---

<aside class="how-to-contribute">
	<h3>Contributing</h3>
	<p>
		Did you find a bug? Do you have an idea? Want to contribute, discuss something, or just say
		hello?
	</p>
	<p>You are welcome.</p>
	<ul>
		<li>
			<a href={githubURL}>GitHub</a>
		</li>
		<li>
			<a href={discordURL}>Discord</a>
		</li>
		<li>
			<a href={contactURL}>Contact</a>
		</li>
	</ul>
</aside>

<style>
	.how-to-contribute {
		display: flex;
		flex-direction: column;
		gap: 0.5rem;
	}

	.how-to-contribute h3 {
		margin: 0;
		font-family: var(--type-noodlestan-family);
		font-size: var(--text-size-heading-3, 1.5rem);
		font-weight: 600;
		color: var(--color-headings, inherit);
	}

	.how-to-contribute p {
		margin: 0;
		max-width: var(--text-max-width, 35em);
	}

	.how-to-contribute ul {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem 1.5rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}
</style>
