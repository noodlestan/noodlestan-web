---
import { GitHubLogoIcon } from '../logos';
import { IconLink } from '../links';

type Props = {
	label?: string;
	iconLabel?: string;
	href?: string;
};

const { label, iconLabel: maybeIconLabel, href = 'https://github.com/noodlestan' } = Astro.props;

const iconLabel = maybeIconLabel || label || 'View on Github';
---

<IconLink href={href} label={iconLabel}>
	<GitHubLogoIcon />
	{label}
</IconLink>
