---
type Props = {
	year: number;
	githubURL: string;
};

const { year, githubURL } = Astro.props;
---

<div class="noodlestan-footer">
	<p class="copyright">
		Copyright © {year} <span class="brand">Noodlestan</span>
	</p>
	<div class="legal">
		<p>
			Code and content available on <a href={githubURL}>GitHub</a> under an MIT LICENSE.
		</p>
		<p>This site respects your privacy: no cookies, analytics, or tracking tools are used.</p>
		<p>This site is built with open source knowledge and tools.</p>
	</div>
</div>

<style>
	.noodlestan-footer {
		--text-max-width: 33rem;
		display: flex;
		flex-direction: column;
		gap: 1rem;
		padding-block: 7rem 5rem;
		font-family: var(--type-headings-family, var(--type-noodlestan-family, sans-serif));
		background: linear-gradient(
			180deg,
			var(--color-gradient-3, transparent) 90%,
			var(--color-gradient-2, transparent) 90%,
			var(--color-gradient-2, transparent) 95%,
			var(--color-gradient-1, transparent) 95%
		);
	}

	.noodlestan-footer .copyright {
		margin: 0;
		font-size: var(--text-size-normal, 1rem);
		font-weight: 400;
	}

	.noodlestan-footer .brand {
		font-family: var(--type-noodlestan-family);
	}

	.noodlestan-footer .legal {
		display: flex;
		flex-direction: column;
		gap: 0.25rem;
		font-size: var(--text-size-small, 0.85rem);
		font-weight: 100;
	}

	.noodlestan-footer p {
		margin: 0;
		max-width: var(--text-max-width);
	}
</style>
