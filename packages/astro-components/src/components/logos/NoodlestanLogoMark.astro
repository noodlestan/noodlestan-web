---
type Props = {
	mono?: boolean;
};

const { mono } = Astro.props;

const className = `noodlestan-logo ${mono ? 'mono' : 'colors'}`;
---

<svg
	class={className}
	xmlns="http://www.w3.org/2000/svg"
	viewBox="0 0 500 371"
	aria-hidden="true"
	focusable="false"
>
	<rect
		width="22.246"
		height="311.865"
		x="348.144"
		y="-10.802"
		fill="currentColor"
		transform="rotate(60.085 358.346 144.6) skewY(-.17)"
	></rect>
	<rect
		width="22.252"
		height="302.686"
		x="304.595"
		y="-36.657"
		fill="currentColor"
		transform="rotate(45.098 314.42 114.149) skewY(-.196)"
	></rect>
	<path
		class="bowl-1"
		fill="currentColor"
		d="M22.05 248H421c-36.66 72.837-112.307 123-199.631 123-87.275 0-162.887-50.11-199.37-122.974Z"
	></path>
	<path
		class="bowl-2"
		fill="currentColor"
		d="M0 178h442a217.4 217.4 0 0 1-17.338 62H17.338A217.4 217.4 0 0 1 0 178"
	></path>
</svg>

<style>
	.noodlestan-logo {
		display: block;
		height: 1em;
		width: auto;
		aspect-ratio: 500 / 371;
	}

	.colors rect {
		fill: #f3661d;
	}

	.colors .bowl-1 {
		fill: #ac44d2;
	}
	.colors .bowl-2 {
		fill: #ffb400;
	}
</style>
