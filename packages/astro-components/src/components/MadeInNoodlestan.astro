---
import NoodlestanLogo from './private/NoodlestanLogo.astro';

type Props = {
	href: string;
};

const { href } = Astro.props;
---

<a class="made-in-noodlestan" href={href}>
	<span class="made-in-noodlestan-brand">
		<NoodlestanLogo />
		<span class="made-in-noodlestan-name">Made in Noodlestan</span>
	</span>
</a>

<style>
	.made-in-noodlestan {
		--noodlestan-logo-size: 1.25rem;
		display: inline-flex;
		align-items: center;
		font-family: var(--type-noodlestan-family);
		text-decoration: none;
	}

	.made-in-noodlestan-brand {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
	}
</style>
