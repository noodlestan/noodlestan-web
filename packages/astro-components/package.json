{
  "name": "@noodlestan/astro-components",
  "version": "0.0.1",
  "description": "Reusable Astro components for Noodlestan websites.",
  "keywords": [
    "astro",
    "components",
    "noodlestan"
  ],
  "author": "Noodlestan Collective",
  "license": "MIT",
  "private": false,
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/noodlestan/noodlestan-web",
    "directory": "packages/astro-components/"
  },
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./global.css": "./src/styles/global.css"
  },
  "files": [
    "src",
    "LICENSE-MIT",
    "README.md"
  ],
  "prettier": "@noodlestan/prettier-config-astro",
  "scripts": {
    "lint": "prettier . -c && eslint . && tsc --noEmit",
    "lint:fix": "prettier . --write && eslint . --fix",
    "test": "echo none yet",
    "ci": "npm run lint && npm run test"
  },
  "peerDependencies": {
    "astro": "^7.2.7"
  },
  "devDependencies": {
    "@noodlestan/prettier-config-astro": "0.1.0",
    "prettier-plugin-astro": "1.1.0"
  }
}
