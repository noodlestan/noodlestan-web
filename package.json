{
  "name": "noodlestan/noodlestan-web",
  "version": "0.0.1",
  "description": "Repository of Noodlestan websites — typically built with Astro.",
  "keywords": [
    "documentation",
    "websites",
    "astro"
  ],
  "author": "Noodlestan",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/noodlestan/noodlestan-web.git"
  },
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "packageManager": "npm@10.2.3",
  "workspaces": [
    "apps/**",
    "packages/**"
  ],
  "prettier": "@noodlestan/prettier-config",
  "scripts": {
    "turbo": "turbo",
    "dev": "turbo run dev --ui tui",
    "clean": "turbo run build:clean",
    "lint": "prettier . -c",
    "lint:fix": "prettier . -c --write",
    "extract": "echo no purrception yet",
    "update-project-records": "tsx scripts/copy-project-records.ts",
    "update-project-collection": "tsx scripts/create-collection.ts",
    "ci:root": "npm run lint",
    "ci": "npm run ci:root && turbo run ci"
  },
  "devDependencies": {
    "@noodlestan/conventions-typescript": "0.1.0",
    "@noodlestan/conventions-unit-tests": "0.1.0",
    "@noodlestan/eslint-config": "0.0.9",
    "@noodlestan/prettier-config": "0.1.1",
    "@noodlestan/tsconfig": "0.2.1",
    "@types/node": "24.13.0",
    "eslint": "8.57.1",
    "lefthook": "2.2.2",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "turbo": "2.11.10",
    "typescript": "5.9.3",
    "vite": "8.3.5",
    "vite-plugin-solid": "2.11.14",
    "vite-plugin-solid-svg": "0.8.1",
    "vitest": "5.0.5"
  }
}
